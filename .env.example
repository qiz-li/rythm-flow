# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Get your API key from: https://platform.openai.com/api-keys
# Note: This will be exposed in the browser, only use for demos/development
# For production, implement server-side transcription

# Socket.IO Configuration for Real-time Collaboration
VITE_SOCKET_URL=ws://localhost:3001

# For production, use wss:// with your server domain
# Example: VITE_SOCKET_URL=wss://your-collaboration-server.com