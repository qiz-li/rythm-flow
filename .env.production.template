# Production Environment Variables
# Copy this file to .env.local for local development
# Set these as environment variables in your deployment platforms

# OpenAI API Configuration (Optional - for fallback transcription)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Socket.IO Configuration for Real-time Collaboration
# Replace with your deployed server URL
VITE_SOCKET_URL=wss://your-server-domain.com

# Example deployment URLs:
# Railway: wss://your-app.up.railway.app
# Render: wss://rhythm-flow-server.onrender.com
# Heroku: wss://your-app.herokuapp.com

# For Vercel deployment, set this in Vercel dashboard:
# VITE_SOCKET_URL=wss://your-deployed-server.com